// Application-level settings for the Runner target.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = GistHunt

// App identity and code signing. macOS needs a team even for local runs,
// because the app stores its token in the Keychain. Copy
// macos/Signing.local.xcconfig.example to macos/Signing.local.xcconfig
// (gitignored) and set your own team and bundle identifier there.
PRODUCT_BUNDLE_IDENTIFIER = com.example.gisthunt
DEVELOPMENT_TEAM =

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2024-2026 Jeffery Abbott. MIT License.

#include? "../../Signing.local.xcconfig"
